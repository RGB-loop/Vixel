{
  "name": "vixel",
  "version": "0.5.1",
  "description": "Private, offline AI search for your photos, videos and audio",
  "main": "./out/main/index.js",
  "author": "Vixel Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RGB-loop/Vixel.git"
  },
  "bugs": {
    "url": "https://github.com/RGB-loop/Vixel/issues"
  },
  "homepage": "https://github.com/RGB-loop/Vixel#readme",
  "scripts": {
    "predev": "node scripts/dev-bundle.mjs && node scripts/build-speech-helper.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage": "npm run build:web && node scripts/build-speech-helper.mjs",
    "package": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:extension": "node scripts/build-extension.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "cli": "npm run build:cli && npx electron dist/cli/cli/index.js",
    "models:download": "node scripts/download-models.mjs",
    "test": "vitest run",
    "eval": "npm run build:cli && ELECTRON_RUN_AS_NODE=1 electron scripts/eval.cjs",
    "test:watch": "vitest",
    "test:db": "npm run build:cli && ELECTRON_RUN_AS_NODE=1 electron scripts/db-smoke.cjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/server-postbuild.mjs",
    "server": "npm run build:server && node dist/server/index.js",
    "server:deps": "npm --prefix server install --no-audit --no-fund",
    "test:server:security": "npm run build:server && node scripts/server-security.mjs",
    "test:web": "node scripts/web-e2e.mjs"
  },
  "bin": {
    "vixel": "./dist/cli/cli/index.js"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "glob": "^13.0.6",
    "heic-convert": "^2.1.0",
    "koffi": "^3.3.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "onnxruntime-node": "^1.24.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "sharp": "^0.34.0",
    "sqlite-vec": "^0.1.7",
    "ws": "^8.22.0",
    "xxhash-wasm": "^1.1.0"
  },
  "overrides": {
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
